pipeline {

    agent any

    parameters {

        choice(
            name: 'MODULE',
            choices: [
                'activemq',
                'digistore',
                'frontend',
                'messaging',
                'node',
                'retail',
                'database',
                'soa'
            ],
            description: 'Select Module'
        )

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'staging',
                'preprod',
                'prod'
            ],
            description: 'Select Environment'
        )

        choice(
            name: 'AWS_ACCOUNT',
            choices: [
                'non-prod',
                'prod'
            ],
            description: 'AWS Account'
        )
    }

    environment {

        AWS_REGION = 'eu-west-1'

        NON_PROD_ID = '194398118151'
        PROD_ID     = '558050136406'

        NODE_OPTIONS = '--openssl-legacy-provider'
    }

    stages {

        stage('Checkout Source') {

            steps {

                script {

                    def moduleConfig = [

                        activemq : [
                            git : 'git@github.com:48months/activemq-cron-module.git',
                            ecr : 'activemq-crons_v2'
                        ],

                        digistore : [
                            git : 'git@github.com:48months/digistore.git',
                            ecr : 'digistore-module_v2'
                        ],

                        frontend : [
                            git : 'git@github.com:48months/frontend-module.git',
                            ecr : 'frontend_v2'
                        ],

                        messaging : [
                            git : 'git@github.com:48months/messaging-module.git',
                            ecr : 'messaging-module_v2'
                        ],

                        node : [
                            git : 'git@github.com:48months/node-module.git',
                            ecr : 'node-module_v2'
                        ],

                        retail : [
                            git : 'git@github.com:48months/retail_sim_store.git',
                            ecr : 'retail-sim-module_v2'
                        ],

                        database : [
                            git : 'git@github.com:48months/database-module.git',
                            ecr : 'java-base-image_v2'
                        ],

                        soa : [
                            git : 'git@github.com:48months/soa-client-module.git',
                            ecr : 'soa-client-module_v2'
                        ]
                    ]

                    env.GIT_REPO = moduleConfig[params.MODULE].git

                    if (params.MODULE == 'database') {

                        switch(params.ENVIRONMENT) {

                            case 'dev':
                            case 'staging':
                                env.ECR_REPO = 'java-base-image_v2'
                                break

                            case 'preprod':
                                env.ECR_REPO = 'pre-prod-java-base-image'
                                break

                            case 'prod':
                                env.ECR_REPO = 'prod-java-base-image'
                                break
                        }

                    } else {

                        env.ECR_REPO = moduleConfig[params.MODULE].ecr
                    }

                    def branchMap = [
                        dev     : 'dev',
                        staging : 'staging',
                        preprod : 'preproduction',
                        prod    : 'production'
                    ]

                    checkout scmGit(
                        branches: [[name: "*/${branchMap[params.ENVIRONMENT]}"]],
                        userRemoteConfigs: [[
                            credentialsId: 'Git_ID',
                            url: env.GIT_REPO
                        ]]
                    )

                    echo """
==================================================
MODULE      : ${params.MODULE}
ENVIRONMENT : ${params.ENVIRONMENT}
GIT REPO    : ${env.GIT_REPO}
ECR REPO    : ${env.ECR_REPO}
==================================================
"""
                }
            }
        }

        stage('Build Application') {

            steps {

                script {

                    if (params.MODULE == 'frontend') {

                        dir('frontend') {

                            sh '''
                            npm cache clean --force || true
                            npm install --force

                            node -v
                            npm -v

                            echo $NODE_OPTIONS
                            '''

                            if (params.ENVIRONMENT in ['dev', 'staging']) {

                                sh '''
                                npx ng build \
                                --aot=true \
                                --prod \
                                --configuration stg
                                '''
                            }
                            else {

                                sh '''
                                npx ng build \
                                --aot=true \
                                --prod
                                '''
                            }
                        }

                    } else if (params.MODULE == 'digistore') {

                        dir('digistore') {

                            sh '''
                            npm cache clean --force || true
                            npm install --force

                            node -v
                            npm -v
                            '''

                            sh '''
                            npx ng build --configuration production
                            '''
                        }

                    } else if (params.MODULE == 'retail') {

                        nodejs('NODESJS_RETAIL') {

                            dir('retail-sim') {

                                sh '''
                                node -v
                                npm -v

                                npm install --force
                                '''

                                if (params.ENVIRONMENT in ['dev', 'staging']) {

                                    sh '''
                                    npx ng build --aot=true
                                    '''
                                }
                                else {

                                    sh '''
                                    npx ng build --aot=true --configuration=production
                                    '''
                                }
                            }
                        }

                    } else if (params.MODULE == 'messaging') {

                        configFileProvider([
                            configFile(
                                fileId: '7027f691-df79-43c4-bbda-a4805d02bd65',
                                variable: 'NEXUS_SETTINGS'
                            )
                        ]) {

                            sh """
                            ${M2}/mvn \
                            -U \
                            -s ${NEXUS_SETTINGS} \
                            clean install \
                            -DskipTests=true
                            """
                        }

                    } else if (params.MODULE == 'soa') {

                        configFileProvider([
                            configFile(
                                fileId: '7027f691-df79-43c4-bbda-a4805d02bd65',
                                variable: 'NEXUS_SETTINGS'
                            )
                        ]) {

                            sh """
                            ${M2}/mvn \
                            -U \
                            -s ${NEXUS_SETTINGS} \
                            clean install \
                            -DskipTests=true
                            """
                        }

                    } else if (params.MODULE == 'database') {

                        def mvnHome = tool(
                            name: 'MAVEN_3.8.8',
                            type: 'maven'
                        )

                        sh """
                        ${mvnHome}/bin/mvn \
                        clean install \
                        -DskipTests=true
                        """

                    } else if (fileExists('package.json')) {

                        sh '''
                        npm install --force
                        '''

                    } else {

                        echo "No build step required"
                    }
                }
            }
        }

        stage('AWS ECR Login') {

            steps {

                script {

                    if (params.MODULE == 'database' &&
                        params.AWS_ACCOUNT == 'prod') {

                        withAWS(
                            credentials: 'aws_non_prod',
                            region: env.AWS_REGION
                        ) {

                            sh """
                            aws ecr get-login-password \
                            --region ${AWS_REGION} | \
                            docker login \
                            --username AWS \
                            --password-stdin \
                            ${NON_PROD_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                            """
                        }
                    }

                    def awsId =
                        params.AWS_ACCOUNT == 'non-prod'
                        ? env.NON_PROD_ID
                        : env.PROD_ID

                    withAWS(
                        credentials:
                        params.AWS_ACCOUNT == 'non-prod'
                        ? 'aws_non_prod'
                        : 'aws_prod',
                        region: env.AWS_REGION
                    ) {

                        sh """
                        aws ecr get-login-password \
                        --region ${AWS_REGION} | \
                        docker login \
                        --username AWS \
                        --password-stdin \
                        ${awsId}.dkr.ecr.${AWS_REGION}.amazonaws.com
                        """
                    }
                }
            }
        }

        stage('Build Docker Image') {

            steps {

                script {

                    env.IMAGE_TAG =
                        "${params.ENVIRONMENT}-${BUILD_NUMBER}"

                    if (params.MODULE == 'frontend') {

                        sh """
                        docker build \
                        --pull \
                        --no-cache \
                        -t frontend:${BUILD_NUMBER} \
                        -f ./frontend/Dockerfile \
                        ./frontend
                        """

                    } else if (params.MODULE == 'digistore') {

                        sh """
                        docker build \
                        --pull \
                        --no-cache \
                        -t digistore:${BUILD_NUMBER} \
                        -f ./digistore/Dockerfile \
                        ./digistore
                        """

                    } else if (params.MODULE == 'database') {

                        def profileMap = [
                            dev     : 'dev',
                            staging : 'staging',
                            preprod : 'preprod',
                            prod    : 'production'
                        ]

                        sh """
                        docker build \
                        --pull \
                        --no-cache \
                        --build-arg profile=${profileMap[params.ENVIRONMENT]} \
                        -t database:${BUILD_NUMBER} \
                        -f Dockerfile .
                        """

                    } else {

                        sh """
                        docker build \
                        --pull \
                        --no-cache \
                        -t ${params.MODULE}:${BUILD_NUMBER} .
                        """
                    }
                }
            }
        }

        stage('Push Docker Image') {

            steps {

                script {

                    def awsId =
                        params.AWS_ACCOUNT == 'non-prod'
                        ? env.NON_PROD_ID
                        : env.PROD_ID

                    def tags = []

                    if (params.ENVIRONMENT == 'dev') {

                        tags = [
                            'latest-dev',
                            "dev-${BUILD_NUMBER}"
                        ]

                    } else if (params.ENVIRONMENT == 'staging') {

                        tags = [
                            'latest-staging',
                            "staging-${BUILD_NUMBER}"
                        ]

                    } else if (params.ENVIRONMENT == 'preprod') {

                        tags = [
                            'latest-preprod',
                            "preprod-${BUILD_NUMBER}"
                        ]

                    } else {

                        tags = [
                            'latest',
                            "prod-${BUILD_NUMBER}"
                        ]
                    }

                    def imageName =
                        params.MODULE == 'database'
                        ? "database:${BUILD_NUMBER}"
                        : "${params.MODULE}:${BUILD_NUMBER}"

                    tags.each { tag ->

                        sh """
                        docker tag \
                        ${imageName} \
                        ${awsId}.dkr.ecr.${AWS_REGION}.amazonaws.com/${env.ECR_REPO}:${tag}

                        docker push \
                        ${awsId}.dkr.ecr.${AWS_REGION}.amazonaws.com/${env.ECR_REPO}:${tag}
                        """
                    }
                }
            }
        }
    }

    post {

        success {

            echo """
==================================================
IMAGE PUSH SUCCESSFUL

MODULE      : ${params.MODULE}
ENVIRONMENT : ${params.ENVIRONMENT}
ECR REPO    : ${env.ECR_REPO}
IMAGE TAG   : ${env.IMAGE_TAG}

==================================================
"""
        }

        failure {

            echo "Image build/push failed"
        }

        always {

            sh '''
            docker system prune -af --volumes || true
            '''

            cleanWs()
        }
    }
}
