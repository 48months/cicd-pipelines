pipeline {

    agent any

    parameters {

        choice(
            name: 'MODULE',
            choices: [
                'activemq',
                'digistore',
                'frontend',
                'messaging',
                'node',
                'retail',
                'soa'
            ],
            description: 'Select Module'
        )

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'staging',
                'preprod',
                'prod'
            ],
            description: 'Select Environment'
        )

        choice(
            name: 'AWS_ACCOUNT',
            choices: [
                'non-prod',
                'prod'
            ],
            description: 'AWS Account'
        )
    }

    environment {

        AWS_REGION = 'eu-west-1'

        NON_PROD_ID = '194398118151'
        PROD_ID     = '558050136406'

        NODE_OPTIONS = '--openssl-legacy-provider'
    }

    stages {

        stage('Checkout Source') {

            steps {

                script {

                    def moduleConfig = [

                        activemq : [
                            path : 'activemq-module',
                            ecr  : 'activemq-crons_v2'
                        ],

                        digistore : [
                            path : 'digistore-module',
                            ecr  : 'digistore-module_v2'
                        ],

                        frontend : [
                            path : 'frontend-module',
                            ecr  : 'frontend_v2'
                        ],

                        messaging : [
                            path : 'messaging-module',
                            ecr  : 'messaging-module_v2'
                        ],

                        node : [
                            path : 'node-module',
                            ecr  : 'node-module_v2'
                        ],

                        retail : [
                            path : 'retail-module',
                            ecr  : 'retail-sim-module_v2'
                        ],

                        soa : [
                            path : 'soa-module',
                            ecr  : 'soa-client-module_v2'
                        ]
                    ]

                    env.MODULE_PATH =
                        moduleConfig[params.MODULE].path

                    env.ECR_REPO =
                        moduleConfig[params.MODULE].ecr

                    def branchMap = [
                        dev     : 'dev',
                        staging : 'staging',
                        preprod : 'preproduction',
                        prod    : 'production'
                    ]

                    checkout scmGit(
                        branches: [[
                            name: "*/${branchMap[params.ENVIRONMENT]}"
                        ]],
                        userRemoteConfigs: [[
                            credentialsId: 'Git_ID',
                            url: 'git@github.com:48months/48-Helm.git'
                        ]]
                    )

                    sh """
                    echo "Workspace Structure"
                    pwd
                    ls -la
                    ls -la ${env.MODULE_PATH} || true
                    """

                    echo """
                    ===================================
                    MODULE      : ${params.MODULE}
                    ENVIRONMENT : ${params.ENVIRONMENT}
                    REPOSITORY  : 48-Helm
                    MODULE PATH : ${env.MODULE_PATH}
                    ECR REPO    : ${env.ECR_REPO}
                    ===================================
                    """
                }
            }
        }

        stage('Build Application') {

            steps {

                script {

                    if (params.MODULE == 'frontend') {

                        dir("${env.MODULE_PATH}") {

                            sh '''
                            npm cache clean --force || true
                            npm install --force

                            node -v
                            npm -v

                            echo $NODE_OPTIONS
                            '''

                            if (params.ENVIRONMENT in ['dev', 'staging']) {

                                sh '''
                                npx ng build \
                                  --aot=true \
                                  --prod \
                                  --configuration stg
                                '''
                            } else {

                                sh '''
                                npx ng build \
                                  --aot=true \
                                  --prod
                                '''
                            }
                        }

                    } else if (params.MODULE == 'digistore') {

                        dir("${env.MODULE_PATH}") {

                            sh '''
                            npm cache clean --force || true
                            npm install --force

                            node -v
                            npm -v

                            echo $NODE_OPTIONS
                            '''

                            sh '''
                            npx ng build --configuration production
                            '''

                            sh '''
                            echo "Build Output"
                            ls -la dist || true
                            find dist -type d || true
                            '''
                        }

                    } else {

                        echo "No build step required"
                    }
                }
            }
        }

        stage('AWS ECR Login') {

            steps {

                script {

                    def awsId = params.AWS_ACCOUNT == 'non-prod'
                        ? env.NON_PROD_ID
                        : env.PROD_ID

                    withAWS(
                        credentials: params.AWS_ACCOUNT == 'non-prod'
                            ? 'aws_non_prod'
                            : 'aws_prod',
                        region: env.AWS_REGION
                    ) {

                        sh """
                        aws ecr get-login-password \
                        --region ${AWS_REGION} | \
                        docker login \
                        --username AWS \
                        --password-stdin \
                        ${awsId}.dkr.ecr.${AWS_REGION}.amazonaws.com
                        """
                    }
                }
            }
        }

        stage('Build Docker Image') {

            steps {

                script {

                    env.IMAGE_TAG =
                        "${params.ENVIRONMENT}-${BUILD_NUMBER}"

                    sh """
                    docker build \
                      --pull \
                      --no-cache \
                      -t ${params.MODULE}:${BUILD_NUMBER} \
                      -f ./${env.MODULE_PATH}/Dockerfile \
                      ./${env.MODULE_PATH}
                    """
                }
            }
        }

        stage('Push Docker Image') {

            steps {

                script {

                    def awsId = params.AWS_ACCOUNT == 'non-prod'
                        ? env.NON_PROD_ID
                        : env.PROD_ID

                    def tags = []

                    if (params.ENVIRONMENT == 'dev') {

                        tags = [
                            'latest-dev',
                            "dev-${BUILD_NUMBER}"
                        ]

                    } else if (params.ENVIRONMENT == 'staging') {

                        tags = [
                            'latest-staging',
                            "staging-${BUILD_NUMBER}"
                        ]

                    } else if (params.ENVIRONMENT == 'preprod') {

                        tags = [
                            'latest-preprod',
                            "preprod-${BUILD_NUMBER}"
                        ]

                    } else {

                        tags = [
                            'latest',
                            "prod-${BUILD_NUMBER}"
                        ]
                    }

                    tags.each { tag ->

                        sh """
                        docker tag \
                        ${params.MODULE}:${BUILD_NUMBER} \
                        ${awsId}.dkr.ecr.${AWS_REGION}.amazonaws.com/${env.ECR_REPO}:${tag}

                        docker push \
                        ${awsId}.dkr.ecr.${AWS_REGION}.amazonaws.com/${env.ECR_REPO}:${tag}
                        """
                    }
                }
            }
        }
    }

    post {

        success {

            echo """
==================================================
IMAGE PUSH SUCCESSFUL

MODULE      : ${params.MODULE}
ENVIRONMENT : ${params.ENVIRONMENT}
ECR REPO    : ${env.ECR_REPO}
IMAGE TAG   : ${env.IMAGE_TAG}

==================================================
"""
        }

        failure {

            echo "Image build/push failed"
        }

        always {

            sh '''
            docker system prune -af --volumes || true
            '''

            cleanWs()
        }
    }
}
