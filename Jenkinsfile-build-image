pipeline {

    agent any

    parameters {

        choice(
            name: 'MODULE',
            choices: [
                'frontend',
                'messaging',
                'node',
                'database',
                'auth',
                'digistore',
                'retail',
                'soa'
            ],
            description: 'Select Module'
        )

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'staging',
                'preprod',
                'prod'
            ],
            description: 'Select Environment'
        )

        choice(
            name: 'AWS_ACCOUNT',
            choices: [
                'non-prod',
                'prod'
            ],
            description: 'AWS Account'
        )
    }

    environment {

        AWS_REGION = 'eu-west-1'

        NON_PROD_ID = '194398118151'
        PROD_ID     = '558050136406'
    }

    stages {

        stage('Checkout Source') {

            steps {

                script {

                    def moduleConfig = [

                        frontend : [
                            git : 'git@github.com:48months/frontend-module.git',
                            ecr : 'frontend-development'
                        ],

                        messaging : [
                            git : 'git@github.com:48months/messaging-module.git',
                            ecr : 'messaging-module-development'
                        ],

                        node : [
                            git : 'git@github.com:48months/node-module.git',
                            ecr : 'node-module-development'
                        ],

                        digistore : [
                            git : 'git@github.com:48months/digistore-module.git',
                            ecr : 'digistore-module'
                        ],

                        retail : [
                            git : 'git@github.com:48months/retail-module.git',
                            ecr : 'retail-sim-module'
                        ],

                        soa : [
                            git : 'git@github.com:48months/soa-module.git',
                            ecr : 'soa-module-development'
                        ],

                        database : [
                            git : 'git@github.com:48months/database-module.git',
                            ecr : 'database-module'
                        ],

                        auth : [
                            git : 'git@github.com:48months/auth-module.git',
                            ecr : 'auth-module'
                        ]
                    ]

                    env.GIT_REPO =
                        moduleConfig[params.MODULE].git

                    env.ECR_REPO =
                        moduleConfig[params.MODULE].ecr

                    def branchMap = [
                        dev     : 'development',
                        staging : 'staging',
                        preprod : 'preproduction',
                        prod    : 'production'
                    ]

                    checkout scmGit(
                        branches: [[name: "*/${branchMap[params.ENVIRONMENT]}"]],
                        userRemoteConfigs: [[
                            credentialsId: 'Git_ID',
                            url: env.GIT_REPO
                        ]]
                    )
                }
            }
        }

        stage('Build Application') {

            steps {

                script {

                    if (fileExists('package.json')) {

                        echo "Node/Angular Application Detected"

                        sh '''
                        npm cache clean --force || true
                        npm install --force
                        '''

                    } else {

                        echo "Skipping npm build"
                    }
                }
            }
        }

        stage('AWS ECR Login') {

            steps {

                script {

                    def awsId = params.AWS_ACCOUNT == 'non-prod'
                        ? env.NON_PROD_ID
                        : env.PROD_ID

                    withAWS(
                        credentials: params.AWS_ACCOUNT == 'non-prod'
                            ? 'aws_non_prod'
                            : 'aws_prod',
                        region: env.AWS_REGION
                    ) {

                        sh """
                        aws ecr get-login-password \
                        --region ${AWS_REGION} | \
                        docker login \
                        --username AWS \
                        --password-stdin \
                        ${awsId}.dkr.ecr.${AWS_REGION}.amazonaws.com
                        """
                    }
                }
            }
        }

        stage('Build Docker Image') {

            steps {

                script {

                    env.IMAGE_TAG =
                        "${params.ENVIRONMENT}-${BUILD_NUMBER}"

                    sh """
                    docker build \
                      --pull \
                      --no-cache \
                      -t ${params.MODULE}:${BUILD_NUMBER} .
                    """
                }
            }
        }

        stage('Push Docker Image') {

            steps {

                script {

                    def awsId = params.AWS_ACCOUNT == 'non-prod'
                        ? env.NON_PROD_ID
                        : env.PROD_ID

                    def tags = []

                    if (params.ENVIRONMENT in ['dev','staging']) {

                        tags = [
                            "latest-${params.ENVIRONMENT}",
                            "${params.ENVIRONMENT}-${BUILD_NUMBER}"
                        ]

                    } else {

                        tags = [
                            "latest",
                            "${params.ENVIRONMENT}-${BUILD_NUMBER}"
                        ]
                    }

                    tags.each { tag ->

                        sh """
                        docker tag \
                        ${params.MODULE}:${BUILD_NUMBER} \
                        ${awsId}.dkr.ecr.${AWS_REGION}.amazonaws.com/${env.ECR_REPO}:${tag}

                        docker push \
                        ${awsId}.dkr.ecr.${AWS_REGION}.amazonaws.com/${env.ECR_REPO}:${tag}
                        """
                    }
                }
            }
        }
    }

    post {

        success {

            echo """
=========================================
Image Push Successful

Module      : ${params.MODULE}
Repository  : ${env.ECR_REPO}
Image Tag   : ${env.IMAGE_TAG}

=========================================
"""
        }

        failure {

            echo "Image build/push failed"
        }

        always {

            sh '''
            docker system prune -af --volumes || true
            '''

            cleanWs()
        }
    }
}
